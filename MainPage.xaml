<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppHotelJuliah.MainPage"
    Title="Reservas"
    BackgroundColor="#FFF8F0">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <Label Text="APP HOTEL"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#795548"
                   HorizontalOptions="Center"/>

            <Label Text="Sua próxima viagem começa aqui!"
                   FontSize="16"
                   TextColor="#8D7770"
                   HorizontalOptions="Center"/>

            <Label Text="Nome do hóspede" TextColor="#795548"/>
            <Entry Placeholder="Digite seu nome"
                   Text="{Binding NomeHospede}"
                   BackgroundColor="White"/>

            <Label Text="Data de entrada" TextColor="#795548"/>
            <DatePicker Date="{Binding DataEntrada}"
                        Format="dd/MM/yyyy"
                        BackgroundColor="White"/>

            <Label Text="Quantidade de hóspedes" TextColor="#795548"/>
            <Stepper Minimum="1"
                     Maximum="10"
                     Increment="1"
                     Value="{Binding QuantidadeHospedes}"/>

            <Label Text="{Binding QuantidadeHospedes, StringFormat='Hóspedes: {0:F0}'}"
                   TextColor="#795548"/>

            <Label Text="Tipo de quarto" TextColor="#795548"/>
            <Picker Title="Selecione o quarto"
                    ItemsSource="{Binding TiposQuarto}"
                    SelectedItem="{Binding TipoQuarto}"
                    BackgroundColor="White"/>

            <Button Text="SOLICITAR RESERVA"
                    Command="{Binding ReservarCommand}"
                    BackgroundColor="#B77878"
                    TextColor="White"
                    CornerRadius="12"/>

            <Label Text="{Binding ResumoReserva}"
                   TextColor="#795548"
                   HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
